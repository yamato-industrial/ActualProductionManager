@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "ホーム";
    var environmentName = ViewData["EnvironmentName"]?.ToString() ?? "Unknown";
    var schema = ViewData["Schema"]?.ToString() ?? "unknown";
}

<div class="row">
    <!-- Welcome Card -->
    <div class="col-12 col-md-8">
        <div class="card card-success">
            <div class="card-header">
                <h3 class="card-title">ようこそ</h3>
            </div>
            <div class="card-body">
                <p>生産実績管理システムのマスタ管理画面です。</p>
                <p class="text-muted">左メニューから各機能にアクセスしてください。</p>
            </div>
        </div>
    </div>

    <!-- Quick Links Card -->
    <div class="col-12 col-md-4">
        <div class="card card-warning">
            <div class="card-header">
                <h3 class="card-title">クイックリンク</h3>
            </div>
            <div class="card-body">
                <ul class="list-unstyled">
                    <li><a asp-area="" asp-controller="ProductionConditions" asp-action="Index"><i class="fas fa-link"></i> 生産条件管理</a></li>
                    <li><a asp-area="" asp-controller="SetupTimes" asp-action="Index"><i class="fas fa-link"></i> 段取り時間管理</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Debug情報表示（Development環境のみ）-->
@if (environmentName == "Development")
{
    <div class="row mt-4">
        <div class="col-12">
            <div class="card card-outline card-info">
                <div class="card-header">
                    <h3 class="card-title">デバッグ情報</h3>
                </div>
                <div class="card-body small">
                    <p><strong>環境:</strong> <code>@environmentName</code></p>
                    <p><strong>スキーマ:</strong> <code>@schema</code></p>
                </div>
            </div>
        </div>
    </div>
}
