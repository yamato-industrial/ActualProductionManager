@{
    ViewData["Title"] = "金型修理履歴 - 新規登録";
}

<div class="row">
    <div class="col-md-12">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title">金型修理履歴新規登録</h3>
            </div>
            <form id="registrationForm" method="post" action="@Url.Action("Store", "MoldMaintenanceHistories")">
                <div class="card-body">
                    <div class="form-group">
                        <label for="moldCode">金型コード <span class="text-danger">*</span></label>
                        <select id="moldCode" name="moldCode" class="form-control" required>
                            <option value="">選択してください</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="moldName">金型名称</label>
                        <input type="text" id="moldName" name="moldName" class="form-control" readonly />
                    </div>
                    <div class="form-group">
                        <label for="maintenanceDate">修理日時<span class="text-danger">*</span></label>
                        <input type="datetime-local" id="maintenanceDate" name="maintenanceDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                    <div class="form-group">
                        <label for="maintenanceShots">修理時ショット数</label>
                        <input type="number" id="maintenanceShots" name="maintenanceShots" class="form-control" min="0" step="1" placeholder="修理実施時点の累積ショット数を入力してください。不明な場合は空欄でも登録できます。" />
                    </div>
                    <div class="form-group">
                        <label for="remarks">修理内容・備考</label>
                        <textarea id="remarks" name="remarks" class="form-control" rows="5" placeholder="修理箇所、交換部品、対応内容などを入力してください"></textarea>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" id="submitButton" class="btn btn-primary">登録</button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">キャンセル</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // 金型コード Select2初期化
            $('#moldCode').select2({
                theme: 'bootstrap-5',
                placeholder: '金型コードを選択してください',
                allowClear: true,
                ajax: {
                    url: '@Url.Action("GetMolds", "MoldMaintenanceHistories")',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            search: params.term
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: data.results
                        };
                    },
                    cache: true
                },
                minimumInputLength: 0
            });

            // 金型コード変更時に金型名称を取得
            $('#moldCode').on('change', function () {
                var code = $(this).val();

                if (code) {
                    $.ajax({
                        url: '@Url.Action("GetMoldName", "MoldMaintenanceHistories")',
                        type: 'GET',
                        data: {
                            code: code
                        },
                        success: function (data) {
                            $('#moldName').val(data.name);
                        },
                        error: function () {
                            $('#moldName').val('');
                        }
                    });
                } else {
                    $('#moldName').val('');
                }
            });

            // フォーム送信時の検証
            $('#registrationForm').on('submit', function (e) {
                var moldCode = $('#moldCode').val();
                var maintenanceDate = $('#maintenanceDate').val();
                var maintenanceShotsText = $('#maintenanceShots').val();

                if (!moldCode || !maintenanceDate) {
                    e.preventDefault();
                    alert('必須項目をすべて入力してください');
                    return false;
                }

                if (maintenanceShotsText) {
                    var maintenanceShots = Number(maintenanceShotsText);

                    if (!Number.isInteger(maintenanceShots) ||
                        maintenanceShots < 0) {
                        e.preventDefault();
                        alert('修理時ショット数には0以上の整数を入力してください');
                        return false;
                    }
                }

                $('#submitButton')
                    .prop('disabled', true)
                    .text('登録中...');

                return true;
            });
        });
    </script>
}