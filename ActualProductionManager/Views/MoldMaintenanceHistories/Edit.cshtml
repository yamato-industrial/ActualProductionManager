@{
    ViewData["Title"] = "金型修理履歴 - 編集";
}

<div class="row">
    <div class="col-md-12">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title">金型修理履歴編集</h3>
            </div>
            <form id="registrationForm" method="post" class="ajax-form" action="@Url.Action("Update")">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <input type="hidden" id="id" name="id" class="form-control" value="@Model.Id" readonly />
                    <div class="form-group">
                        <label for="moldCode">金型コード <span class="text-danger">*</span></label>
                        <input type="text" id="moldCode" name="moldCode" class="form-control" value="@Model.MoldCode" readonly />
                    </div>
                    <div class="form-group">
                        <label>金型名称</label>
                        <input type="text" id="moldName" name="moldName" class="form-control" value="@Model.MoldName" readonly />
                    </div>
                    <div class="form-group">
                        <label for="maintenanceDate">修理日<span class="text-danger">*</span></label>
                        <input type="date" id="maintenanceDate" name="maintenanceDate" class="form-control" value="@Model.MaintenanceDate.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="form-group">
                        <label for="maintenanceShots">修理時ショット数</label>
                        <input type="number" id="maintenanceShots" name="maintenanceShots" class="form-control" value="@Model.MaintenanceShots" min="0" step="1" placeholder="修理実施時点の累積ショット数を入力してください。不明な場合は空欄でも登録できます。" />
                    </div>
                    <div class="form-group">
                        <label for="remarks">修理内容・備考</label>
                        <textarea id="remarks" name="remarks" class="form-control" rows="5" placeholder="修理箇所、交換部品、対応内容などを入力してください">@Model.Remarks</textarea>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">更新</button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">キャンセル</a>
                </div>
            </form>
        </div>
    </div>
</div>