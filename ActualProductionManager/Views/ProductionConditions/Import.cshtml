@{
    ViewData["Title"] = "生産条件 CSV取込";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">CSV取込</h3>
            </div>

            <div class="card-body">
                <!-- CSVフォーマット説明 -->
                <div class="mb-4">
                    <h5 class="mb-3">
                        <i class="fas fa-file-csv text-success"></i>
                        CSVファイルの形式
                    </h5>

                    <div class="bg-light border-left border-4 border-success p-3 mb-3">
                        <div class="font-monospace text-dark">
                            ラインコード,品目コード,目標サイクルタイム(秒),サイクルあたりの本数
                        </div>
                    </div>

                    <h6 class="mb-2">例：</h6>
                    <div class="bg-white border border-secondary rounded p-3">
                        <div class="font-monospace text-dark">
                            LINE001,ITEM001,120,1<br>
                            LINE001,ITEM002,180,2<br>
                            LINE002,ITEM001,100,1
                        </div>
                    </div>
                </div>

                <hr>

                <form id="importForm" enctype="multipart/form-data">
                    <div class="form-group">
                        <label for="csvFile">CSVファイルを選択</label>
                        <div class="custom-file">
                            <input type="file" class="custom-file-input" id="csvFile" name="csvFile" accept=".csv" required>
                            <label class="custom-file-label" for="csvFile">ファイルを選択...</label>
                        </div>
                        <small class="form-text text-muted">*.csv形式のファイルのみ対応しています</small>
                    </div>

                    <div class="form-group">
                        <div class="custom-control custom-radio">
                            <input type="radio" id="modeUpsert" class="custom-control-input" name="importMode" value="upsert" checked>
                            <label class="custom-control-label" for="modeUpsert">
                                既存データを更新（既に登録されているラインコード＆品目コードは更新、新規は追加）
                            </label>
                        </div>
                        <div class="custom-control custom-radio">
                            <input type="radio" id="modeReplace" class="custom-control-input" name="importMode" value="replace">
                            <label class="custom-control-label" for="modeReplace">
                                置き換え（既存データをすべて削除し、CSVファイルのデータで置き換え）
                            </label>
                        </div>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-upload"></i> 取込を開始
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            <i class="fas fa-times"></i> キャンセル
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card bg-light">
            <div class="card-header">
                <h3 class="card-title">注意事項</h3>
            </div>
            <div class="card-body">
                <ul class="small">
                    <li>ファイルは UTF-8 エンコーディングで保存してください</li>
                    <li>ヘッダー行は含めないでください</li>
                    <li>ラインコードと品目コードは既存のマスタに登録されている必要があります</li>
                    <li>目標サイクルタイムは0より大きい正の整数を指定してください</li>
                    <li>ピース/サイクルは0より大きい正の整数を指定してください</li>
                    <li>エラーが発生した場合、データは保存されません</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ファイル名表示
        document.getElementById('csvFile').addEventListener('change', function (e) {
            var fileName = e.target.files[0]?.name || 'ファイルを選択...';
            document.querySelector('.custom-file-label').textContent = fileName;
        });

        // フォーム送信処理
        document.getElementById('importForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const form = this;
            const formData = new FormData(form);

            try {
                const response = await fetch('@Url.Action("ImportFile", "ProductionConditions")', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (data.success) {
                    // 成功時
                    AppModal.showSuccess(
                        'インポート完了',
                        `${data.message}`
                    );

                    // 2秒後に一覧ページへリダイレクト
                    setTimeout(() => {
                        window.location.href = '@Url.Action("Index", "ProductionConditions")';
                    }, 2000);
                } else {
                    // エラー時
                    let errorMessage = data.error;
                    if (data.details) {
                        errorMessage += '<br><br>' + data.details;
                    }

                    AppModal.showError(
                        'インポートエラー',
                        errorMessage
                    );
                }
            } catch (error) {
                console.error('Error:', error);
                AppModal.showError(
                    'エラーが発生しました',
                    'インポート処理中に予期しないエラーが発生しました。'
                );
            }
        });
    </script>
}