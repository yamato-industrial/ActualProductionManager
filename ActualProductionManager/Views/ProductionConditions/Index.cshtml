@model List<ActualProductionManager.Controllers.ProductionConditionViewModel>

@{
    ViewData["Title"] = "生産条件";
    var searchLineCode = ViewData["SearchLineCode"]?.ToString();
    var searchItemCode = ViewData["SearchItemCode"]?.ToString();
    var sortBy = ViewData["SortBy"]?.ToString() ?? "lineCode";
    var sortOrder = ViewData["SortOrder"]?.ToString() ?? "asc";
    var pageSize = (int)(ViewData["PageSize"] ?? 10);
    var currentPage = (int)(ViewData["Page"] ?? 1);
    var totalCount = (int)(ViewData["TotalCount"] ?? 0);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var pageSizes = new[] { 10, 25, 50, 100 };
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">生産条件一覧</h3>
                <div class="card-tools">
                    <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i> 新規登録
                    </a>
                    <a href="@Url.Action("Import")" class="btn btn-success btn-sm">
                        <i class="fas fa-file-csv"></i> CSV取込
                    </a>
                </div>
            </div>

            <!-- フィルタセクション -->
            <div class="card-body bg-light">
                <form method="get" class="form-inline" style="gap: 10px;">
                    <div class="form-group">
                        <label for="searchLineCode" class="mr-2">ラインコード:</label>
                        <input type="text" id="searchLineCode" name="searchLineCode" class="form-control form-control-sm" value="@searchLineCode" placeholder="検索...">
                    </div>
                    <div class="form-group">
                        <label for="searchItemCode" class="mr-2">品目コード:</label>
                        <input type="text" id="searchItemCode" name="searchItemCode" class="form-control form-control-sm" value="@searchItemCode" placeholder="検索...">
                    </div>
                    <button type="submit" class="btn btn-info btn-sm">
                        <i class="fas fa-search"></i> 検索
                    </button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm">
                        <i class="fas fa-redo"></i> リセット
                    </a>
                </form>
            </div>

            <!-- テーブル -->
            <div class="card-body">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>
                                <a href="@Url.Action("Index", new { searchLineCode, searchItemCode, sortBy = "lineCode", sortOrder = (sortBy == "lineCode" && sortOrder == "asc") ? "desc" : "asc" })">
                                    ラインコード
                                    @if (sortBy == "lineCode")
                                    {
                                        <i class="fas fa-sort-@(sortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a href="@Url.Action("Index", new { searchLineCode, searchItemCode, sortBy = "lineName", sortOrder = (sortBy == "lineName" && sortOrder == "asc") ? "desc" : "asc" })">
                                    ライン名
                                    @if (sortBy == "lineName")
                                    {
                                        <i class="fas fa-sort-@(sortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a href="@Url.Action("Index", new { searchLineCode, searchItemCode, sortBy = "itemCode", sortOrder = (sortBy == "itemCode" && sortOrder == "asc") ? "desc" : "asc" })">
                                    品目コード
                                    @if (sortBy == "itemCode")
                                    {
                                        <i class="fas fa-sort-@(sortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a href="@Url.Action("Index", new { searchLineCode, searchItemCode, sortBy = "itemName", sortOrder = (sortBy == "itemName" && sortOrder == "asc") ? "desc" : "asc" })">
                                    品目番号/名称
                                    @if (sortBy == "itemName")
                                    {
                                        <i class="fas fa-sort-@(sortOrder == "asc" ? "up" : "down")"></i>
                                    }
                                </a>
                            </th>
                            <th>目標サイクルタイム(秒)</th>
                            <th>サイクルあたりの個数</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var condition in Model)
                            {
                                <tr>
                                    <td>@condition.LineCode</td>
                                    <td>@condition.LineName</td>
                                    <td>@condition.ItemCode</td>
                                    <td>@condition.ItemName</td>
                                    <td>
                                        <form method="post" action="@Url.Action("Update")" style="display:inline;">
                                            <input type="hidden" name="lineCode" value="@condition.LineCode" />
                                            <input type="hidden" name="itemCode" value="@condition.ItemCode" />
                                            <input type="hidden" name="piecesPerCycle" value="@condition.PiecesPerCycle" />
                                            <div class="input-group input-group-sm" style="width: 120px;">
                                                <input type="number" class="form-control" name="targetCycleTime" value="@condition.TargetCycleTime" min="1" />
                                                <span class="input-group-append">
                                                    <button type="submit" class="btn btn-info btn-flat">
                                                        <i class="fas fa-save"></i>
                                                    </button>
                                                </span>
                                            </div>
                                        </form>
                                    </td>
                                    <td>
                                        <form method="post" action="@Url.Action("Update")" style="display:inline;">
                                            <input type="hidden" name="lineCode" value="@condition.LineCode" />
                                            <input type="hidden" name="itemCode" value="@condition.ItemCode" />
                                            <input type="hidden" name="TargetCycleTime" value="@condition.TargetCycleTime" />
                                            <div class="input-group input-group-sm" style="width: 120px;">
                                                <input type="number" class="form-control" name="piecesPerCycle" value="@condition.PiecesPerCycle" min="1" />
                                                <span class="input-group-append">
                                                    <button type="submit" class="btn btn-info btn-flat">
                                                        <i class="fas fa-save"></i>
                                                    </button>
                                                </span>
                                            </div>
                                        </form>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Delete", new { lineCode = condition.LineCode, itemCode = condition.ItemCode })" class="btn btn-danger btn-sm" onclick="return confirm('削除してよろしいですか？')">
                                            <i class="fas fa-trash"></i> 削除
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">表示対象のデータがありません</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <form method="get" class="form-inline">
                        <input type="hidden" name="searchLineCode" value="@searchLineCode" />
                        <input type="hidden" name="searchItemCode" value="@searchItemCode" />
                        <input type="hidden" name="sortBy" value="@sortBy" />
                        <input type="hidden" name="sortOrder" value="@sortOrder" />
                        <label for="pageSize" class="mr-2">表示件数:</label>
                        <select id="pageSize" name="pageSize" class="form-control form-control-sm" onchange="this.form.submit()">
                            @foreach (var size in pageSizes)
                            {
                                <option value="@size" selected="@(size == pageSize)">@size 件</option>
                            }
                        </select>
                    </form>
                    <div class="text-muted text-sm">@totalCount 件中 @(((currentPage - 1) * pageSize) + (Model.Any() ? 1 : 0)) - @(Math.Min(currentPage * pageSize, totalCount)) 件を表示</div>
                    <ul class="pagination pagination-sm m-0">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")"><a class="page-link" href="@Url.Action("Index", new { searchLineCode, searchItemCode, sortBy, sortOrder, pageSize, page = currentPage - 1 })">前へ</a></li>
                        <li class="page-item disabled"><span class="page-link">@currentPage / @totalPages</span></li>
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")"><a class="page-link" href="@Url.Action("Index", new { searchLineCode, searchItemCode, sortBy, sortOrder, pageSize, page = currentPage + 1 })">次へ</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>