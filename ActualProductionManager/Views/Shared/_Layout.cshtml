@* 実績収集マネージャーのマスターレイアウトページ。全ページで共通される基本構造を定義。 *@
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - 実績収集マネージャー</title>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <link rel="stylesheet" href="~/adminlte/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/overlayScrollbars/css/OverlayScrollbars.min.css">
    <link rel="stylesheet" href="~/adminlte/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <div class="preloader flex-column justify-content-center align-items-center">
            <img class="animation__shake" src="~/adminlte/dist/img/AdminLTELogo.png" alt="AdminLTEロゴ" height="60" width="60">
        </div>

        <!-- ナビゲーションバー -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
            </ul>

            <!-- 開発環境の表示 -->
            <ul class="navbar-nav ms-auto">
                @if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
                {
                    <li class="nav-item">
                        <span class="badge badge-info">
                            <i class="fas fa-circle"></i>
                            開発環境
                        </span>
                    </li>
                }
            </ul>
        </nav>

        <!-- サイドバー -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="/" class="brand-link">
                <i class="nav-icon fas fa-chart-line"></i>
                <span class="brand-text font-weight-light">実績収集</span>
            </a>
            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">

                        <!-- ホーム -->
                        <li class="nav-item">
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-home"></i>
                                <p>ホーム</p>
                            </a>
                        </li>

                        <!-- マスタ管理 -->
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-cogs"></i>
                                <p>
                                    マスタ管理
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="" asp-controller="ProductionConditions" asp-action="Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>生産条件</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="" asp-controller="SetupTimes" asp-action="Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>段取り時間</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- コンテンツエリア -->
        <div class="content-wrapper">
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1 class="m-0">@ViewData["Title"]</h1>
                        </div>
                    </div>
                </div>
            </div>

            <!-- メインコンテンツ -->
            <section class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>
        <aside class="control-sidebar control-sidebar-dark">
        </aside>

        <!-- フッター -->
        <footer class="main-footer">
            <strong>実績収集マスタ管理アプリケーション</strong>
            <div class="float-right d-none d-sm-inline-block">
                <b>バージョン</b> 0.1.1
            </div>
        </footer>
    </div>

    <!-- 共通モーダルコンテナ -->
    <div class="modal fade" id="commonModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="commonModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="commonModalLabel">通知</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                </div>
                <div class="modal-body" id="commonModalBody">
                    <!-- コンテンツがここに挿入される -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">閉じる</button>
                    <button type="button" class="btn btn-primary" id="commonModalConfirmBtn" style="display: none;">確認</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 必須スクリプト -->
    <script src="~/adminlte/plugins/jquery/jquery.min.js"></script>
    <script src="~/adminlte/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/adminlte/plugins/overlayScrollbars/js/jquery.overlayScrollbars.min.js"></script>
    <script src="~/adminlte/dist/js/adminlte.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        // 汎用モーダル表示用オブジェクト
        const AppModal = {
            // モーダル要素とBootstrapモーダルインスタンス
            element: null,
            modal: null,

            // 初期化
            init: function () {
                this.element = document.getElementById('commonModal');
                // Bootstrapのオプションを明示的に設定
                this.modal = new bootstrap.Modal(this.element, {
                    backdrop: 'static',  // static で背景クリック無効化
                    keyboard: true       // Esc キー有効化
                });

                // モーダルが閉じるときのイベントリスナー
                this.element.addEventListener('hidden.bs.modal', () => {
                    this.reset();
                });

                // data-bs-dismiss属性を持つボタンに対するイベント委譲
                this.element.addEventListener('click', (event) => {
                    if (event.target.hasAttribute('data-bs-dismiss')) {
                        this.modal.hide();
                    }
                });
            },

            // 成功メッセージを表示
            showSuccess: function (title, message, onConfirm) {
                this.show('success', title, message, onConfirm);
            },

            // エラーメッセージを表示
            showError: function (title, message, onConfirm) {
                this.show('error', title, message, onConfirm);
            },

            // 警告メッセージを表示
            showWarning: function (title, message, onConfirm) {
                this.show('warning', title, message, onConfirm);
            },

            // 情報メッセージを表示
            showInfo: function (title, message, onConfirm) {
                this.show('info', title, message, onConfirm);
            },

            // 確認ダイアログを表示
            showConfirm: function (title, message, onConfirm, onCancel) {
                this.show('confirm', title, message, onConfirm);
                const confirmBtn = document.getElementById('commonModalConfirmBtn');
                confirmBtn.style.display = 'block';
                confirmBtn.textContent = '確認';
                confirmBtn.onclick = () => {
                    if (onConfirm) onConfirm();
                    this.hide();
                };
            },

            // 内部用：モーダルを表示
            show: function (type, title, message, onConfirm) {
                if (!this.modal) {
                    this.init();
                }

                const titleElement = document.getElementById('commonModalLabel');
                const bodyElement = document.getElementById('commonModalBody');
                const confirmBtn = document.getElementById('commonModalConfirmBtn');

                titleElement.textContent = title;
                bodyElement.innerHTML = '';

                // アイコンとメッセージをレンダリング
                const messageDiv = document.createElement('div');
                messageDiv.className = 'd-flex align-items-center';

                const iconSpan = document.createElement('span');
                iconSpan.className = 'me-3';
                iconSpan.style.fontSize = '24px';

                switch (type) {
                    case 'success':
                        iconSpan.innerHTML = '<i class="fas fa-check-circle text-success"></i>';
                        break;
                    case 'error':
                        iconSpan.innerHTML = '<i class="fas fa-times-circle text-danger"></i>';
                        break;
                    case 'warning':
                        iconSpan.innerHTML = '<i class="fas fa-exclamation-circle text-warning"></i>';
                        break;
                    case 'info':
                        iconSpan.innerHTML = '<i class="fas fa-info-circle text-info"></i>';
                        break;
                    case 'confirm':
                        iconSpan.innerHTML = '<i class="fas fa-question-circle text-primary"></i>';
                        break;
                }

                messageDiv.appendChild(iconSpan);

                const textDiv = document.createElement('div');
                textDiv.innerHTML = message;
                messageDiv.appendChild(textDiv);

                bodyElement.appendChild(messageDiv);

                if (type !== 'confirm') {
                    confirmBtn.style.display = 'none';
                }

                this.modal.show();
            },

            // モーダルを閉じる
            hide: function () {
                if (this.modal) {
                    this.modal.hide();
                }
            },

            // 状態をリセット
            reset: function () {
                const confirmBtn = document.getElementById('commonModalConfirmBtn');
                confirmBtn.style.display = 'none';
                confirmBtn.onclick = null;
            }
        };

        // ページロード時に初期化
        document.addEventListener('DOMContentLoaded', function () {
            AppModal.init();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
