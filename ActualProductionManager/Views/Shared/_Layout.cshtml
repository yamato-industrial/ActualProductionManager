@* 実績収集マネージャーのマスターレイアウトページ。全ページで共通される基本構造を定義。 *@
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - 実績収集マネージャー</title>

    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <link rel="stylesheet" href="~/adminlte/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/adminlte/plugins/overlayScrollbars/css/OverlayScrollbars.min.css">
    <link rel="stylesheet" href="~/adminlte/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <div class="preloader flex-column justify-content-center align-items-center">
            <img class="animation__shake" src="~/adminlte/dist/img/AdminLTELogo.png" alt="AdminLTEロゴ" height="60" width="60">
        </div>

        <!-- ナビゲーションバー -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
            </ul>

            <!-- 開発環境の表示 -->
            <ul class="navbar-nav ms-auto">
                @if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
                {
                    <li class="nav-item">
                        <span class="badge badge-info">
                            <i class="fas fa-circle"></i>
                            開発環境
                        </span>
                    </li>
                }
            </ul>
        </nav>

        <!-- サイドバー -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="/" class="brand-link">
                <i class="nav-icon fas fa-chart-line"></i>
                <span class="brand-text font-weight-light">実績収集</span>
            </a>
            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">

                        <!-- ホーム -->
                        <li class="nav-item">
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-home"></i>
                                <p>ホーム</p>
                            </a>
                        </li>

                        <!-- マスタ管理 -->
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-cogs"></i>
                                <p>
                                    マスタ管理
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a asp-area="" asp-controller="ProductionConditions" asp-action="Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>生産条件</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="" asp-controller="SetupTimes" asp-action="Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>段取り時間</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="" asp-controller="Molds" asp-action="Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>金型</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a asp-area="" asp-controller="MoldMaintenanceHistories" asp-action="Index" class="nav-link">
                                        <i class="far fa-circle nav-icon"></i>
                                        <p>金型修理履歴</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- コンテンツエリア -->
        <div class="content-wrapper">
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1 class="m-0">@ViewData["Title"]</h1>
                        </div>
                    </div>
                </div>
            </div>

            <!-- メインコンテンツ -->
            <section class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>
        <aside class="control-sidebar control-sidebar-dark">
        </aside>

        <!-- フッター -->
        <footer class="main-footer">
            <strong>実績収集マスタ管理アプリケーション</strong>
            <div class="float-right d-none d-sm-inline-block">
                <b>バージョン</b> @GetAssemblyVersion()
            </div>
        </footer>
    </div>

    <!-- 必須スクリプト -->
    <script src="~/adminlte/plugins/jquery/jquery.min.js"></script>
    <script src="~/adminlte/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/adminlte/plugins/overlayScrollbars/js/jquery.overlayScrollbars.min.js"></script>
    <script src="~/adminlte/dist/js/adminlte.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        window.AppNotify = {
            colors: {
                success: '#28a745',
                info: '#17a2b8',
                warning: '#ffc107',
                error: '#dc3545',
                question: '#3085d6'
            },

            alert: function (options) {
                const type = options.type ?? 'info';

                return Swal.fire({
                    icon: type,
                    title: options.title ?? 'お知らせ',
                    text: options.message ?? '',
                    confirmButtonText: options.confirmButtonText ?? 'はい',
                    confirmButtonColor: options.confirmButtonColor ?? this.colors[type] ?? this.colors.info,
                    allowOutsideClick: false
                });
            },

            confirm: function (options) {
                const type = options.type ?? 'warning';

                return Swal.fire({
                    icon: type,
                    title: options.title ?? '確認',
                    text: options.message ?? '',
                    showCancelButton: true,
                    confirmButtonText: options.confirmButtonText ?? 'はい',
                    cancelButtonText: options.cancelButtonText ?? 'いいえ',
                    confirmButtonColor: options.confirmButtonColor ?? this.colors[type] ?? this.colors.warning,
                    cancelButtonColor: '#6c757d',
                    allowOutsideClick: false
                });
            },

            toast: function (options) {
                const type = options.type ?? 'success';

                return Swal.fire({
                    toast: true,
                    position: options.position ?? 'top-end',
                    icon: type,
                    title: options.message ?? '',
                    showConfirmButton: false,
                    timer: options.timer ?? 3000,
                    timerProgressBar: true,
                    background: options.background ?? '#ffffff',
                    didOpen: function (toast) {
                        toast.addEventListener('mouseenter', Swal.stopTimer);
                        toast.addEventListener('mouseleave', Swal.resumeTimer);
                    }
                });
            },

            error: function (message) {
                return this.alert({
                    type: 'error',
                    title: 'エラー',
                    message: message,
                    confirmButtonText: '閉じる'
                });
            },

            warning: function (message) {
                return this.alert({
                    type: 'warning',
                    title: '警告',
                    message: message,
                    confirmButtonText: '確認'
                });
            },

            success: function (message) {
                return this.toast({type: 'success', message: message});
            },

            info: function (message) {
                return this.toast({type: 'info', message: message});
            }
        };
    </script>

    <script>
        $(document).on(
            'submit',
            '.ajax-form',
            async function (event) {
                event.preventDefault();

                const form = this;
                const submitButton =form.querySelector('button[type="submit"]');
                const confirmTitle = form.dataset.confirmTitle;
                const confirmMessage = form.dataset.confirmMessage;

                if (confirmMessage) {
                    const result =
                        await AppNotify.confirm({
                            type: form.dataset.confirmType ?? 'warning',
                            title: confirmTitle ?? '確認',
                            message: confirmMessage,
                            confirmButtonText: form.dataset.confirmButtonText ?? 'はい',
                            cancelButtonText: form.dataset.cancelButtonText ?? 'いいえ'
                        });

                    if (!result.isConfirmed) {
                        return;
                    }
                }

                if (submitButton) {
                    submitButton.disabled = true;
                }

                try {
                    const response = await fetch(
                        form.action,
                        {
                            method: form.method || 'POST',
                            body: new FormData(form),
                            headers: {'X-Requested-With': 'XMLHttpRequest'}
                        });

                    const contentType = response.headers.get( 'content-type');
                    if (!contentType || !contentType.includes('application/json'))
                    {
                        throw new Error('サーバーから正しい応答を取得できませんでした。');
                    }

                    const data = await response.json();
                    if (!response.ok ||
                        !data.success) {
                        throw new Error(
                            data.message ??
                            '処理に失敗しました。');
                    }

                    AppNotify.success(
                        data.message ??
                        '処理が完了しました。');

                    const removeSelector =
                        form.dataset.removeTarget;

                    if (removeSelector) {
                        const target =
                            form.closest(removeSelector);

                        target?.remove();
                    }

                    const redirectUrl =
                        data.redirectUrl ??
                        form.dataset.redirectUrl;

                    if (redirectUrl) {
                        setTimeout(function () {
                            window.location.href =
                                redirectUrl;
                        }, 800);

                        return;
                    }

                    if (form.dataset.reload === 'true') {
                        setTimeout(function () {
                            window.location.reload();
                        }, 800);

                        return;
                    }

                    if (form.dataset.reset === 'true') {
                        form.reset();

                        $(form)
                            .find('select')
                            .val(null)
                            .trigger('change');
                    }
                }
                catch (error) {
                    console.error(error);

                    AppNotify.error(
                        error.message ??
                        '予期しないエラーが発生しました。');
                }
                finally {
                    if (submitButton) {
                        submitButton.disabled = false;
                    }
                }
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    private string GetAssemblyVersion()
    {
        var version = typeof(Program).Assembly.GetName().Version;
        return version?.ToString() ?? "0.0.0.0";
    }
}